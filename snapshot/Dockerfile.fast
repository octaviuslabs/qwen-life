FROM qwen-life:dev

# Optional inference kernels used by Transformers' Qwen3.5 DeltaNet layers.
# They change execution speed only; the checkpoint and its programmed weights
# are identical to the reference-kernel build.
RUN python -m pip install --no-cache-dir --no-build-isolation \
    "causal-conv1d==1.7.0" \
    "flash-linear-attention==0.6.0"

# The current NGC image's Triton build does not expose the Gluon API expected
# by FLA 0.6.  Keep the compiled causal-convolution kernel, and deliberately
# fall back to Transformers' correct PyTorch DeltaNet rule until those versions
# converge.  Leaving a broken `fla` import installed would prevent startup.
RUN python -m pip uninstall -y flash-linear-attention fla-core
